{
  "manifest_version": 2,
  "name": "YT Playback Speed",
  "version": "1.9",
  "description": "Increase YouTube playback speed up to 3x straight from the player settings menu.",
  "permissions": [
    "storage",
    "*://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "css": [
        "player.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-playback-speed@S1M0N38.github.io",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/S1M0N38/yt-playback-speed/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
